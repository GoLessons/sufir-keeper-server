DB_DSN=postgres://keeper:keeper@postgres:5432/keeper?sslmode=disable
DB_MAX_OPEN=20
DB_MAX_IDLE=10
DB_LIFETIME=1800
DB_IDLE=300

HTTP_ADDR=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=30
HTTP_HEADER_TIMEOUT=10
HTTP_WRITE_TIMEOUT=30
HTTP_IDLE_TIMEOUT=120
HTTP_MAX_BODY=10485760

HTTP_LOG_SUCCESS=info
HTTP_LOG_4XX=warn
HTTP_LOG_5XX=error

AUTH_JWT_SECRET=dev-secret-change-in-prod
AUTH_ACCESS_TTL=3600
AUTH_REFRESH_TTL=2592000

MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token
VAULT_KV_PATH=keeper/keyencrypt

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=keeper
MINIO_WEBHOOK_SECRET=dev-webhook-secret
